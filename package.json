{
  "name": "menote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @menote/shared build && pnpm --filter @menote/web dev",
    "build": "pnpm --filter @menote/shared build && pnpm --filter @menote/web build",
    "typecheck": "tsc -b && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @menote/shared build && pnpm -r --if-present test",
    "check:size": "node scripts/check-bundle-size.mjs",
    "deploy": "pnpm build && pnpm --filter @menote/web exec wrangler deploy -c dist/menote/wrangler.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
