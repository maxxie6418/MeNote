{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menote",
  // 注意：受 @cloudflare/vitest-pool-workers 0.22 内置 workerd 上限（2026-08-22）
  // 约束，本地测试跑不了更新的兼容日；该包跟进后随 wrangler 一并上移
  "compatibility_date": "2026-08-22",
  // 唯一 Worker 入口（架构 §2.3.1）：只做装配，业务在 routes/ 与 services/
  "main": "apps/worker/src/index.ts",
  "assets": {
    // SPA：未命中静态资源时回 index.html；/api、/mcp 与它们的子路径一律由 Worker 处理
    // （只写 "/api/*" 时，无尾斜杠的 /api 会落 SPA 回退返回 HTML；/mcp 同理）
    //
    // **MCP 必须在这里列出来**：它是 POST 端点，若被 SPA 回退接走，客户端拿到的是
    // 一份 HTML 而不是 JSON-RPC 响应——而且失败方式很隐蔽（HTTP 200 + HTML），
    // 排查时容易误以为是鉴权或协议问题。
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/mcp", "/mcp/*"],
    "binding": "ASSETS"
  },
  // 不写 database_id：部署时自动供给并回写（架构 §15.5，wrangler ≥ 4.45）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menote-db",
      // 显式指定：插件会把默认值改写为 <仓库根>/migrations（不存在）导致迁移报错
      "migrations_dir": "apps/worker/src/db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  // 附件与版本正文的对象存储（M4；《M4 设计》§3.1）。与 D1 一样不写 id：部署时自动供给。
  // 键形如 a/{uid}/{sha256} 与 a/{uid}/{sha256}.t（缩略图）。
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "menote-attachments"
    }
  ],
  // 定时任务（M4-8；架构 §12.1：每 15 分钟一轮——R2 GC、每日维护推进一步、注册开关归位）。
  // 用户设置里的三样都按"配额 + 游标 + 幂等"容忍重复，**不加锁**（设计 §7 的结论）。
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
  // 注意：**不要**在这里写 "secrets": { "required": [...] }。
  // 该字段是 deploy 的硬门禁（不是"提示"）：机密没设时 `wrangler deploy` 直接失败，
  // 而首次部署时 Worker 还不存在、无法先设机密 —— 会把一键部署/Workers Builds 彻底堵死。
  // 机密清单改用文档 + .dev.vars.example 说明；运行时缺机密由 middleware/config-guard.ts 明确报 503。
}
